<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<OutputPath>..\..\bin</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- 本工程有多个样例各带 Main：-p:ENTJOY_STARTUP=<全限定类型名> 选入口（只影响本工程，不传播到库工程）；
		     不传时用缺省入口，避免 CS0017。 -->
		<StartupObject Condition="'$(ENTJOY_STARTUP)' != ''">$(ENTJOY_STARTUP)</StartupObject>
		<StartupObject Condition="'$(ENTJOY_STARTUP)' == ''">EntJoySample.HotReload.Program</StartupObject>
		<!-- CS8500：生成器对组件指针取址是 ECS 固有模式（组件约束为 struct） -->
		<NoWarn>$(NoWarn);8500</NoWarn>
		<!-- AutoSIMD 的"我已量过"开关（NT024）：本样例的 AutoSIMD job 就是被测对象 -->
		<EntJoyAutoSimdMeasured>true</EntJoyAutoSimdMeasured>
	</PropertyGroup>

	<!-- 两套「重型对比样本」定义了同名 job/组件（生成器以简单名为键）⇒ 同时活动会 CS0102/CS0111 -->
	<ItemGroup Condition="'$(ENTJOY_SAMPLE_SET)' != 'movecompare'">
		<Compile Remove="02_IJobChunkECS\IJobChunkMoveCompareTest\**" />
	</ItemGroup>
	<ItemGroup Condition="'$(ENTJOY_SAMPLE_SET)' == 'movecompare'">
		<Compile Remove="03_NativeTranspiler\AutoSIMDTest\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\EntJoy.ECS.SourceGenerator\EntJoy.ECS.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\EntJoy.ECS\EntJoy.ECS.csproj" />
	</ItemGroup>

	<!-- 原生转译链（分析器 / 编译 task / 链接套件）由共享 props/targets 提供 -->
	<Import Project="..\..\src\EntJoy.Jobs\msbuild\EntJoy.Jobs.props" />
	<Import Project="..\..\src\EntJoy.Jobs\msbuild\EntJoy.Jobs.targets" />

</Project>
