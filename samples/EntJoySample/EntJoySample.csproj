<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<BaseOutputPath>..\..\..\bin</BaseOutputPath>
		<OutputPath>..\..\..\bin</OutputPath>

		<!-- 鍏抽敭璁剧疆锛氬彇娑堣嚜鍔ㄨ拷锟?TargetFramework 瀛愮洰锟?-->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="NativeTranspiler_Generated\**" />
		<EmbeddedResource Remove="NativeTranspiler_Generated\**" />
		<None Remove="NativeTranspiler_Generated\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\EntJoy.ECS.SourceGenerator\EntJoy.ECS.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\EntJoy.ECS\EntJoy.ECS.csproj" />
		<ProjectReference Include="..\..\src\NativeTranspiler\NativeTranspiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<!-- 锟?鏂板锛氬紩鐢ㄤ换鍔￠」鐩紝浠ョ‘淇濆畠鍏堟瀯寤猴紝浣嗕笉澶嶅埗鍒拌繍琛屾椂 -->
		<ProjectReference Include="..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj" ReferenceOutputAssembly="false" Private="false" BuildReference="false" />
	</ItemGroup>

	<!-- 鏄惧紡閰嶇疆鍘熺敓 NativeDll 婧愮爜鐩綍锛堟簮鐢熸垚鍣?+ 缂栬瘧浠诲姟鍏辩敤锛?-->
	<PropertyGroup>
		<EntJoyNativeDllDir>$(MSBuildThisFileDirectory)..\..\src\NativeDll</EntJoyNativeDllDir>
	</PropertyGroup>
	<ItemGroup>
		<CompilerVisibleProperty Include="EntJoyNativeDllDir" />
	</ItemGroup>

	<!-- 涓嶅啀寮哄埗娓呴櫎鐢熸垚鐩綍锛涗繚鐣欎笂娆＄敓鎴愮殑鏂囦欢浠ユ敮鎸佸閲忔锟?
	      NativeCompileTask 渚濊禆 stamp 鏂囦欢瀵规瘮鏃堕棿鎴虫潵鍒ゆ柇鏄惁闇€瑕侀噸鏂扮紪锟?-->
	<UsingTask TaskName="NativeTranspiler.Tasks.NativeCompileTask" AssemblyFile="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\bin\$(Configuration)\netstandard2.0\NativeTranspiler.Tasks.dll" TaskFactory="TaskHostFactory" />

	<Target Name="BuildNativeTranspilerTasks" BeforeTargets="CompileCppWithCustomTask"
	        Inputs="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeCompileTask.cs;$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj"
	        Outputs="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\bin\$(Configuration)\netstandard2.0\NativeTranspiler.Tasks.dll">
		<MSBuild
			Projects="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj"
			Targets="Build"
			Properties="Configuration=$(Configuration)" />
	</Target>

	<Target Name="CleanStaleNativeTranspilerBindings" BeforeTargets="CoreCompile">
		<RemoveDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\NativeTranspiler" ContinueOnError="true" />
		<RemoveDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\NativeTranspiler.Analyzer.NativeTranspilerGenerator" ContinueOnError="true" />
		<RemoveDir Directories="$(IntermediateOutputPath)NativeTranspiler" ContinueOnError="true" />
		<RemoveDir Directories="$(IntermediateOutputPath)NativeTranspiler.Analyzer.NativeTranspilerGenerator" ContinueOnError="true" />
	</Target>

  <Target Name="CompileCppWithCustomTask" AfterTargets="CoreCompile" DependsOnTargets="BuildNativeTranspilerTasks" Condition="'$(EnableNativeCompile)' != 'false' And Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\CMakeLists.txt')">
		<Message Importance="high" Text="Starting native compilation for generated C++ code..." />
		<NativeCompileTask NativeCodeGenDir="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\" NativeDllDir="$(EntJoyNativeDllDir)" />
	</Target>

	<Target Name="CopyNativeDll" AfterTargets="CompileCppWithCustomTask" Condition="'$(EnableNativeCompile)' != 'false'">
		<ItemGroup>
			<NativeDll Include="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeDll.dll" Condition="Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeDll.dll')" />
			<!-- DLL 鍒嗙锛氱敓鎴愪唬鐮佺嫭锟?DLL锛屼竴骞跺鍒跺埌杈撳嚭 -->
			<NativeDll Include="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeTranspiled.dll" Condition="Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeTranspiled.dll')" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" Condition="@(NativeDll) != ''" />
	</Target>

	<Target Name="CleanLegacyNativeTranspilerDll" AfterTargets="CopyNativeDll">
		<!-- 鍘嗗彶閬楃暀锛氬悎骞跺墠鐨勫崟 DLL 鍚嶏紝鍒犻櫎閬垮厤涓叉棫鐗堟湰 -->
		<Delete Files="$(OutputPath)NativeTranspiler_Generated.dll" ContinueOnError="true" />
	</Target>

</Project>
