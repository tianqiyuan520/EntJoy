<Project Sdk="Godot.NET.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>$(GodotProjectDir).godot\mono\temp\bin\</BaseOutputPath>

    <!-- 关键设置：取消自动跟踪 TargetFramework 子目录 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- NU1900: 包漏洞数据需要联网拉取，离线/受限网络时静默失败，不阻塞还原 -->
    <NuGetAudit>false</NuGetAudit>
    <!-- CS8500: 源生成器生成的 N 元组查询对组件指针取址是 ECS 固有模式 -->
    <NoWarn>$(NoWarn);8500</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NativeTranspiler_Generated\**" />
    <EmbeddedResource Remove="NativeTranspiler_Generated\**" />
    <None Remove="NativeTranspiler_Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EntJoy.ECS.SourceGenerator\EntJoy.ECS.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\EntJoy.ECS\EntJoy.ECS.csproj" />
    <ProjectReference Include="..\..\src\NativeTranspiler\NativeTranspiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- 新增：引用任务项目，以确保它先构建，但不复制到运行时 -->
    <ProjectReference Include="..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj" ReferenceOutputAssembly="false" Private="false" BuildReference="false" />
  </ItemGroup>

  <!-- 显式配置原生 NativeDll 源码目录（源生成器 + 编译任务共用）-->
  <PropertyGroup>
    <EntJoyNativeDllDir>$(MSBuildThisFileDirectory)..\..\src\NativeDll</EntJoyNativeDllDir>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="EntJoyNativeDllDir" />
  </ItemGroup>

  <!-- 不再强制清除生成目录；保留上次生成的文件以支持增量检查
       NativeCompileTask 依赖 stamp 文件对比时间戳来判断是否需要重新编译 -->
  <UsingTask TaskName="NativeTranspiler.Tasks.NativeCompileTask" AssemblyFile="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\bin\$(Configuration)\netstandard2.0\NativeTranspiler.Tasks.dll" TaskFactory="TaskHostFactory" />

  <Target Name="BuildNativeTranspilerTasks" BeforeTargets="CompileCppWithCustomTask"
          Inputs="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeCompileTask.cs;$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj"
          Outputs="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\bin\$(Configuration)\netstandard2.0\NativeTranspiler.Tasks.dll">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CleanStaleNativeTranspilerBindings" BeforeTargets="CoreCompile">
    <RemoveDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\NativeTranspiler" ContinueOnError="true" />
    <RemoveDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\NativeTranspiler.Analyzer.NativeTranspilerGenerator" ContinueOnError="true" />
    <RemoveDir Directories="$(IntermediateOutputPath)NativeTranspiler" ContinueOnError="true" />
    <RemoveDir Directories="$(IntermediateOutputPath)NativeTranspiler.Analyzer.NativeTranspilerGenerator" ContinueOnError="true" />
  </Target>

  <Target Name="CompileCppWithCustomTask" AfterTargets="CoreCompile" DependsOnTargets="BuildNativeTranspilerTasks" Condition="'$(EnableNativeCompile)' != 'false' And Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\CMakeLists.txt')">
    <Message Importance="high" Text="Starting Godot native compilation for generated C++/ISPC code..." />
    <NativeCompileTask NativeCodeGenDir="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\" NativeDllDir="$(EntJoyNativeDllDir)" />
  </Target>

  <Target Name="CopyNativeDll" AfterTargets="CompileCppWithCustomTask" Condition="'$(EnableNativeCompile)' != 'false'">
    <ItemGroup>
      <NativeDll Include="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeDll.dll" Condition="Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeDll.dll')" />
      <!-- DLL 分离：生成代码独DLL，一并复制到输出 -->
      <NativeDll Include="$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeTranspiled.dll" Condition="Exists('$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeTranspiled.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" Condition="@(NativeDll) != ''" />
  </Target>

  <Target Name="CleanLegacyNativeTranspilerDll" AfterTargets="CopyNativeDll">
    <!-- 历史遗留：合并前的单 DLL 名，删除避免串旧版本 -->
    <Delete Files="$(OutputPath)NativeTranspiler_Generated.dll" ContinueOnError="true" />
  </Target>

  <!-- Godot 特有：额外复制 DLL 到输出目录（兼容旧逻辑） -->
  <PropertyGroup>
    <_GodotGeneratedNativeDllPath>$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeTranspiled.dll</_GodotGeneratedNativeDllPath>
    <_GodotGeneratedCoreNativeDllPath>$(MSBuildThisFileDirectory)NativeTranspiler_Generated\build\Release\NativeDll.dll</_GodotGeneratedCoreNativeDllPath>
    <_NativeDllSourcePath Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\bin\NativeDll.dll')">$(MSBuildThisFileDirectory)..\..\..\bin\NativeDll.dll</_NativeDllSourcePath>
    <_NativeDllSourcePath Condition="'$(_NativeDllSourcePath)' == '' And Exists('$(MSBuildThisFileDirectory)bin\NativeDll.dll')">$(MSBuildThisFileDirectory)bin\NativeDll.dll</_NativeDllSourcePath>
    <_EntJoySourcePath Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\EntJoy.ECS\bin\$(Configuration)\net8.0\EntJoy.ECS.dll')">$(MSBuildThisFileDirectory)..\..\src\EntJoy.ECS\bin\$(Configuration)\net8.0\EntJoy.ECS.dll</_EntJoySourcePath>
  </PropertyGroup>

  <Target Name="CopyDllsToGodot" AfterTargets="Build">
    <!-- 生成代码 DLL（NativeTranspiled.dll）优先从生成目录拷贝 -->
    <Copy SourceFiles="$(_GodotGeneratedNativeDllPath)" DestinationFiles="$(OutputPath)NativeTranspiled.dll" SkipUnchangedFiles="true" Condition="Exists('$(_GodotGeneratedNativeDllPath)')" />
    <!-- 核心 DLL：优先用生成目录的（与生成代码同批编译），否则回退到 bin -->
    <Copy SourceFiles="$(_GodotGeneratedCoreNativeDllPath)" DestinationFiles="$(OutputPath)NativeDll.dll" SkipUnchangedFiles="true" Condition="Exists('$(_GodotGeneratedCoreNativeDllPath)')" />
    <Copy SourceFiles="$(_NativeDllSourcePath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="!Exists('$(_GodotGeneratedCoreNativeDllPath)') And Exists('$(_NativeDllSourcePath)')" />
    <Copy SourceFiles="$(_EntJoySourcePath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(_EntJoySourcePath)')" />
  </Target>

  <Target Name="CopyDllsToGodotPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(_GodotGeneratedNativeDllPath)" DestinationFiles="$(PublishDir)NativeTranspiled.dll" SkipUnchangedFiles="true" Condition="Exists('$(_GodotGeneratedNativeDllPath)')" />
    <Copy SourceFiles="$(_GodotGeneratedCoreNativeDllPath)" DestinationFiles="$(PublishDir)NativeDll.dll" SkipUnchangedFiles="true" Condition="Exists('$(_GodotGeneratedCoreNativeDllPath)')" />
    <Copy SourceFiles="$(_NativeDllSourcePath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="!Exists('$(_GodotGeneratedCoreNativeDllPath)') And Exists('$(_NativeDllSourcePath)')" />
    <Copy SourceFiles="$(_EntJoySourcePath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(_EntJoySourcePath)')" />
  </Target>
</Project>
