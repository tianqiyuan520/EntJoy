<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>EntJoy.ECS</AssemblyName>
    <!-- CS8632: 代码中的 ? 注解（无 #nullable 上下文）为代码风格告警，库 API 保持 oblivious 以避免
         影响 nullable-enable 消费者的可空性分析（启用 annotations 会转嫁 CS8600 系列新警告） -->
    <NoWarn>$(NoWarn);8632</NoWarn>
    <!-- CS8500: 对泛型组件指针取址是 ECS 固有模式（组件约束为 struct，运行时不取托管指针） -->
    <NoWarn>$(NoWarn);8500</NoWarn>
    <!-- CA2014: stackalloc 在 <=4096 字节分支内（有界），属 ECS 值拷贝热路径惯用法，非真实栈溢出风险 -->
    <NoWarn>$(NoWarn);CA2014</NoWarn>

    <!-- 方案 J：ECS 入口包（用户唯一需要写的 PackageReference） -->
    <IsPackable>true</IsPackable>
    <PackageId>EntJoy.ECS</PackageId>
    <Title>EntJoy.ECS</Title>
    <Description>EntJoy Archetype ECS（headless）：Entity / Component / Query / Chunk / 关系 / 共享组件 / Observer，配套 ECS 源生成器；原生 JobSystem 与 NativeTranspiler 由依赖 EntJoy.Jobs 提供（仅 win-x64）。</Description>
    <PackageTags>ecs;archetype;dots;headless</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EntJoy.Collections\EntJoy.Collections.csproj" />
    <ProjectReference Include="..\EntJoy.Jobs\EntJoy.Jobs.csproj" />
    <!-- 源生成器以 Analyzer 引用，使引用 EntJoy.ECS 的用户自动获得生成能力。
         PrivateAssets=all：它随本包 analyzers\ 目录分发，不应成为包依赖。 -->
    <ProjectReference Include="..\EntJoy.ECS.SourceGenerator\EntJoy.ECS.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- ECS 源生成器随本包分发（analyzers\ 为 NuGet 约定的分析器目录） -->
    <None Include="..\EntJoy.ECS.SourceGenerator\bin\$(Configuration)\netstandard2.0\EntJoy.ECS.SourceGenerator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
