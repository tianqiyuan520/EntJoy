<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>EntJoy.Mathematics</AssemblyName>
    <!-- CS8981: math 类对标 Unity Mathematics 的 API 命名（全小写是刻意设计），静音保留 -->
    <NoWarn>$(NoWarn);8981</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>EntJoy.Mathematics</PackageId>
    <Title>EntJoy.Mathematics</Title>
    <Description>EntJoy 数学类型：SIMD 友好的 POD 数学库（float2/int2/uint2、位运算与内存工具）。</Description>
    <PackageTags>ecs;math;simd</PackageTags>
  </PropertyGroup>
</Project>
