using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;

namespace NativeTranspiler.Analyzer
{
    public class OuterSimdGenerator
    {
        private readonly MethodDeclarationSyntax _methodSyntax;
        private readonly SemanticModel _semanticModel;
        private readonly string _idx;
        private readonly Dictionary<string, string> _boolFields;

        public OuterSimdGenerator(MethodDeclarationSyntax methodSyntax, SemanticModel semanticModel, string indexVarName,
            Dictionary<string, string>? boolFieldValues = null)
        {
            _methodSyntax = methodSyntax;
            _semanticModel = semanticModel;
            _idx = indexVarName;
            _boolFields = boolFieldValues ?? new Dictionary<string, string>();
        }

        public string Generate(string scalarBody)
        {
            // Check if the body is simple SoA (continuous read + arithmetic + write)
            bool isSimpleSoa = IsSimpleSoaBody();
            if (isSimpleSoa)
                return GenerateRegisterSIMD(scalarBody);
            else if (IsReductionBody())
                return GenerateReductionSIMD(scalarBody);
            else
                return GeneratePerLane(scalarBody);
        }

        // ----------------------------------------------------------------
        // Path 0: Full-Width SIMD (ISPC-style foreach, no per-lane extraction)
        // Keeps all 8 queries in SIMD registers throughout the entire body,
        // using mask-based control flow for if/continue/for.
        // ----------------------------------------------------------------

        /// <summary>
        /// Determines if the Execute body can benefit from Full-Width SIMD.
        /// Requires: body has loop/if/continue patterns (not simple SoA),
        /// and does NOT have patterns we cannot SIMD-ify (dynamic dispatch, indirect indexing, etc.)
        /// </summary>
        private bool CanFullWidthSIMD()
        {
            // Full-Width SIMD is disabled for current workloads.
            // The while(true)+v_i+=1 inner reduction is element-by-element (not SIMD-batched),
            // which is far slower than GenerateReductionSIMD's 8-at-a-time for small cells (avg 2.5).
            // Re-enable for jobs with large inner reduction loops (>>8 per cell).
            // Root cause (crash): missing upper-bound clamp on cellHash gather index.
            // Root cause (slow): no SIMD stride in inner while loop.
            return false;
        }

        /// <summary>Check if any for-loop body references SIMD-bound variables</summary>
        private bool FWSIMD_HasSIMDVarInForLoops(IEnumerable<StatementSyntax> stmts)
        {
            foreach (var stmt in stmts)
            {
                if (stmt is ForStatementSyntax forStmt && forStmt.Condition != null)
                {
                    if (FWSIMD_HasSIMDVarInExpr(forStmt.Condition)) return true;
                    if (FWSIMD_HasSIMDVarInForLoops(GetStmts(forStmt.Statement))) return true;
                }
                else if (stmt is IfStatementSyntax ifStmt)
                {
                    if (FWSIMD_HasSIMDVarInForLoops(GetStmts(ifStmt.Statement))) return true;
                    if (ifStmt.Else != null && FWSIMD_HasSIMDVarInForLoops(GetStmts(ifStmt.Else.Statement))) return true;
                }
                else if (stmt is BlockSyntax block)
                {
                    if (FWSIMD_HasSIMDVarInForLoops(block.Statements)) return true;
                }
            }
            return false;
        }

        private bool FWSIMD_HasSIMDVarInExpr(ExpressionSyntax expr)
        {
            foreach (var id in expr.DescendantNodes().OfType<IdentifierNameSyntax>())
            {
                string n = id.Identifier.Text;
                if (n == "start" || n == "end" || n == "bestDistSq" || n == "bestIdx")
                    return true;
            }
            return false;
        }

        /// <summary>
        /// Generate Full-Width SIMD code: all 8 lanes execute the body simultaneously
        /// with mask-managed control flow. Only the final result write uses per-lane extraction.
        /// </summary>
        private string GenerateFullWidthSIMD(string scalarBody)
        {
            var sb = new StringBuilder();
            var ctx = new FWSIMDCtx { Indent = 2 };

            // Extract dereferenced uniform names from scalar body for reference
            var uniforms = CollectUniformFieldNames(scalarBody);

            sb.AppendLine("    // --- Full-Width SIMD (ISPC-style foreach) ---");
            sb.AppendLine("    printf(\"\"); fflush(stdout);  // barrier: prevent MSVC from optimizing away clamp");
            sb.AppendLine("    int simd_end_ = __startIndex + ((__count) / NSIMD_WIDTH) * NSIMD_WIDTH;");
            sb.AppendLine("    if (simd_end_ > __startIndex)");
            sb.AppendLine("    {");
            sb.AppendLine("        simd_value<int> v_base = simd_value<int>::sequence(0);");
            sb.AppendLine("        for (int si = __startIndex; si < simd_end_; si += NSIMD_WIDTH)");
            sb.AppendLine("        {");
            ctx.Indent = 3;

            // Register Execute parameter (e.g. "index") as SIMD → maps to v_{_idx}
            ctx.SimdVars.Add(_idx);
            sb.AppendLine(ctx.I() + $"simd_value<int> v_{_idx} = v_base + si;");
            sb.AppendLine(ctx.I() + "simd_mask __mask = simd_mask::all_true();");

            // Generate SIMD body from AST — the body handles:
            //   float2 q = QueryPositions[index] → v_q gather via element access
            //   int2 cell = ... → per-component SIMD compute
            //   for/if/continue → mask management
            //   Results[idx] = -1 → per-lane write
            //   HashIndex[bestIdx].y → per-lane fallback
            if (_methodSyntax.Body != null)
            {
                FWSIMD_GenerateStatements(_methodSyntax.Body.Statements, sb, ctx, uniforms);
            }

            sb.AppendLine("        }");
            sb.AppendLine("    }");
            sb.AppendLine(RemainderLoop(scalarBody));
            return sb.ToString();
        }

        // ================================================================
        // Full-Width SIMD: helpers
        // ================================================================

        /// <summary>Context for Full-Width SIMD code generation</summary>
        private class FWSIMDCtx
        {
            public int Indent;
            public int VarCounter;
            public int MaskCounter;
            /// <summary>C# variable names that map to simd_value<T> in C++</summary>
            public HashSet<string> SimdVars = new();

            public string I() => new string(' ', Indent * 4);
            public string NewVar() => $"__t{VarCounter++}";
            public string NewMask() => $"__m{MaskCounter++}";
        }

        /// <summary>
        /// Extract field names that are dereferenced as uniform references
        /// (not array pointers). Parses scalar body for "const T& NAME = *NAME_ptr;" patterns.
        /// </summary>
        private static HashSet<string> CollectUniformFieldNames(string scalarBody)
        {
            var set = new HashSet<string>();
            var re = new Regex(@"const\s+\S+\s+(\w+)\s*=\s*\*\1_ptr;");
            foreach (Match m in re.Matches(scalarBody))
                set.Add(m.Groups[1].Value);
            return set;
        }

        // ================================================================
        // Full-Width SIMD: statement generators
        // ================================================================

        /// <summary>Generate SIMD statements from a list of C# statements</summary>
        private void FWSIMD_GenerateStatements(IEnumerable<StatementSyntax> stmts, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            foreach (var stmt in stmts)
                FWSIMD_GenerateStatement(stmt, sb, ctx, uniforms);
        }

        private void FWSIMD_GenerateStatement(StatementSyntax stmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            switch (stmt)
            {
                case BlockSyntax block:
                    FWSIMD_GenerateStatements(block.Statements, sb, ctx, uniforms);
                    return;
                case ExpressionStatementSyntax exprStmt:
                    FWSIMD_GenerateExpressionStatement(exprStmt, sb, ctx, uniforms);
                    return;
                case LocalDeclarationStatementSyntax localDecl:
                    FWSIMD_GenerateLocalDecl(localDecl, sb, ctx, uniforms);
                    return;
                case ForStatementSyntax forStmt:
                    FWSIMD_GenerateForStatement(forStmt, sb, ctx, uniforms);
                    return;
                case IfStatementSyntax ifStmt:
                    FWSIMD_GenerateIfStatement(ifStmt, sb, ctx, uniforms);
                    return;
                default:
                    break;
            }
        }

        /// <summary>Generate SIMD for an expression statement (typically assignment)</summary>
        private void FWSIMD_GenerateExpressionStatement(ExpressionStatementSyntax exprStmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            if (exprStmt.Expression is AssignmentExpressionSyntax assign)
            {
                FWSIMD_GenerateAssignment(assign, sb, ctx, uniforms);
                return;
            }
            // Other expression types (post-incr, etc.) — translate as SIMD expression
            string expr = FWSIMD_TranslateExpr(exprStmt.Expression, ctx, uniforms);
            sb.AppendLine(ctx.I() + expr + ";");
        }

        /// <summary>Handle left = right for SIMD or per-lane assignments</summary>
        private void FWSIMD_GenerateAssignment(AssignmentExpressionSyntax assign, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            bool rhsHasSIMD = FWSIMD_HasSIMDVar(assign.Right, ctx);
            string rhs = rhsHasSIMD
                ? null // Don't translate — will use per-lane extraction directly
                : FWSIMD_TranslateExpr(assign.Right, ctx, uniforms);

            if (assign.Left is ElementAccessExpressionSyntax elemAccess)
            {
                var exprType = _semanticModel.GetTypeInfo(elemAccess.Expression).Type;
                string arrName = FWSIMD_TranslateExpr(elemAccess.Expression, ctx, uniforms);

                if (exprType?.Name == "NativeArray" || exprType?.Name == "NativeList")
                {
                    string ptrName = $"{arrName}_ptr";
                    // Per-lane write loop
                    sb.AppendLine(ctx.I() + $"for (int lane = 0; lane < NSIMD_WIDTH; lane++) {{");
                    sb.AppendLine(ctx.I() + $"    int idx = si + lane;");

                    if (rhsHasSIMD)
                    {
                        // RHS contains SIMD vars → extract per-lane (guarded by mask to prevent OOB)
                        string laneRhs = FWSIMD_RHSWithLaneExtract(assign.Right, ctx, uniforms);
                        sb.AppendLine(ctx.I() + $"    // Only write for lanes active in __mask (SIMD mask = NaN for active, 0 for inactive)");
                        sb.AppendLine(ctx.I() + $"    if (n_extract_lane_f32(__mask.m, lane) != 0.0f)");
                        sb.AppendLine(ctx.I() + $"        {ptrName}[idx] = {laneRhs};");
                    }
                    else if (rhs != null)
                    {
                        // RHS is uniform/literal → use directly
                        sb.AppendLine(ctx.I() + $"    {ptrName}[idx] = {rhs};");
                    }
                    sb.AppendLine(ctx.I() + "}");
                    return;
                }
            }

            if (assign.Left is IdentifierNameSyntax id)
            {
                string name = id.Identifier.Text;
                // For SIMD-to-SIMD assignment, always translate RHS directly (not per-lane)
                string rhsStr = FWSIMD_TranslateExpr(assign.Right, ctx, uniforms);
                if (ctx.SimdVars.Contains(name))
                {
                    sb.AppendLine(ctx.I() + $"v_{name} = {rhsStr};");
                }
                else
                {
                    sb.AppendLine(ctx.I() + $"{name} = {rhsStr};");
                }
                return;
            }

            if (assign.Left is MemberAccessExpressionSyntax ma)
            {
                // cell.x = ... or q.x = ... → SIMD member assignment
                string exprStr = FWSIMD_TranslateExpr(ma.Expression, ctx, uniforms);
                sb.AppendLine(ctx.I() + $"{exprStr}.{ma.Name.Identifier.Text} = {rhs};");
                return;
            }

            sb.AppendLine(ctx.I() + $"/* assign: {assign.Left} = {rhs} */");
        }

        /// <summary>Generate SIMD variable declarations</summary>
        private void FWSIMD_GenerateLocalDecl(LocalDeclarationStatementSyntax localDecl, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            var typeInfo = _semanticModel.GetTypeInfo(localDecl.Declaration.Type);
            var declType = typeInfo.Type;
            if (declType == null) return;

            foreach (var variable in localDecl.Declaration.Variables)
            {
                string name = variable.Identifier.Text;
                string simdType = GetSIMDValueType(declType);

                if (simdType != null)
                {
                    ctx.SimdVars.Add(name);
                    // Handle compound types (float2/int2) specially
                    if (declType.Name == "float2" || declType.Name == "int2")
                    {
                        FWSIMD_GenerateCompoundDecl(name, declType.Name, variable, sb, ctx, uniforms);
                        continue;
                    }

                    // Simple scalar types (float, int)
                    if (variable.Initializer != null)
                    {
                        string init = FWSIMD_TranslateExpr(variable.Initializer.Value, ctx, uniforms);
                        if (FWSIMD_IsScalarOnly(variable.Initializer.Value, uniforms))
                            init = $"{simdType}::broadcast({init})";
                        sb.AppendLine(ctx.I() + $"{simdType} v_{name} = {init};");
                    }
                    else
                    {
                        sb.AppendLine(ctx.I() + $"{simdType} v_{name};");
                    }
                }
                else
                {
                    // Scalar variable (loop counter, temp)
                    string cppType = NativeTranspiler.MapCSharpTypeToCpp(declType);
                    if (variable.Initializer != null)
                    {
                        string init = FWSIMD_TranslateExpr(variable.Initializer.Value, ctx, uniforms);
                        sb.AppendLine(ctx.I() + $"{cppType} {name} = {init};");
                    }
                    else
                    {
                        sb.AppendLine(ctx.I() + $"{cppType} {name};");
                    }
                }
            }
        }

        /// <summary>Generate SIMD per-component declaration for float2/int2.</summary>
        private void FWSIMD_GenerateCompoundDecl(string name, string typeName, VariableDeclaratorSyntax variable,
            StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string simdType = typeName == "float2"
                ? "simd_value<EntJoy::Mathematics::float2>"
                : "simd_value<EntJoy::Mathematics::int2>";

            sb.AppendLine(ctx.I() + $"{simdType} v_{name};");

            if (variable.Initializer == null) return;

            var initExpr = variable.Initializer.Value;

            // Handle gather directly: SortedPositions[index] or QueryPositions[index] or CellStartEnd[hash]
            if (initExpr is ElementAccessExpressionSyntax elem)
            {
                var exprType = _semanticModel.GetTypeInfo(elem.Expression).Type;
                string idx = FWSIMD_TranslateExpr(elem.ArgumentList.Arguments[0].Expression, ctx, uniforms);
                if (exprType?.Name == "NativeArray" || exprType?.Name == "NativeList")
                {
                    // Emit gather directly instead of per-component
                    string ptr = FWSIMD_TranslateExpr(elem.Expression, ctx, uniforms);
                    if (typeName == "float2")
                        sb.AppendLine(ctx.I() + $"v_{name} = simd_value<EntJoy::Mathematics::float2>::gather({ptr}_ptr, {idx});");
                    else
                    {
                        string basePtr = exprType?.Name == "NativeList" ? $"{ptr}.Ptr" : $"{ptr}_ptr";
sb.AppendLine(ctx.I() + $"simd_value<int> __c = simd_min(simd_max({idx}, simd_value<int>::broadcast(0)), simd_value<int>::broadcast(GridDimensions.x() * GridDimensions.y() - 1));");
                        sb.AppendLine(ctx.I() + $"v_{name} = simd_value<EntJoy::Mathematics::int2>::gather({basePtr}, __c);");
                    }
                    return;
                }
            }

            // Decompose into x and y components
            string xInit = FWSIMD_ComponentString(initExpr, 'x', ctx, uniforms);
            string yInit = FWSIMD_ComponentString(initExpr, 'y', ctx, uniforms);
            sb.AppendLine(ctx.I() + $"v_{name}.x = {xInit};");
            sb.AppendLine(ctx.I() + $"v_{name}.y = {yInit};");
        }

        /// <summary>
        /// Extract a single component ('x' or 'y') from a float2/int2 expression.
        /// Handles: arithmetic, math.floor, math.clamp, casts, member access.
        /// </summary>
        private string FWSIMD_ComponentString(ExpressionSyntax expr, char component, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            // Unwrap parenthesized expressions
            while (expr is ParenthesizedExpressionSyntax paren)
                expr = paren.Expression;

            var type = _semanticModel.GetTypeInfo(expr).Type;
            string comp = component.ToString();

            // Identifier: float2/int2 variable → component access
            if (expr is IdentifierNameSyntax id)
            {
                string name = id.Identifier.Text;
                if (ctx.SimdVars.Contains(name))
                    return $"v_{name}.{comp}";
                if (uniforms.Contains(name) || IsVectorType(type))
                    return $"{name}.{comp}()";
                return name; // scalar
            }

            // Member access: float2.zero → 0; or .x on uniform
            if (expr is MemberAccessExpressionSyntax ma)
            {
                if (ma.Name.Identifier.Text == "zero")
                    return "0";
                // For GridDimensions.x or similar where type is scalar
                string inner = FWSIMD_TranslateExpr(ma.Expression, ctx, uniforms);
                string member = ma.Name.Identifier.Text;
                if (member == "x" || member == "y")
                {
                    bool uni = uniforms.Contains(inner) || IsVectorType(_semanticModel.GetTypeInfo(ma.Expression).Type);
                    return uni ? $"{inner}.{member}()" : $"{inner}.{member}";
                }
                return FWSIMD_TranslateExpr(expr, ctx, uniforms);
            }

            // Cast: (int2)float2 → convert(component)
            if (expr is CastExpressionSyntax cast)
            {
                var targetType = _semanticModel.GetTypeInfo(cast.Type).Type;
                string inner = FWSIMD_ComponentString(cast.Expression, component, ctx, uniforms);
                if (targetType?.Name == "int2")
                    return $"simd_value<int>::convert({inner})";
                return $"({NativeTranspiler.MapCSharpTypeToCpp(targetType!)})({inner})";
            }

            // Binary: a + b → component(a) + component(b) if vector, else a + b
            if (expr is BinaryExpressionSyntax bin)
            {
                var leftType = _semanticModel.GetTypeInfo(bin.Left).Type;
                var rightType = _semanticModel.GetTypeInfo(bin.Right).Type;
                bool leftIsVec = leftType?.Name is "float2" or "int2" or "uint2";
                bool rightIsVec = rightType?.Name is "float2" or "int2" or "uint2";
                string l = leftIsVec ? FWSIMD_ComponentString(bin.Left, component, ctx, uniforms)
                                     : FWSIMD_TranslateExpr(bin.Left, ctx, uniforms);
                string r = rightIsVec ? FWSIMD_ComponentString(bin.Right, component, ctx, uniforms)
                                      : FWSIMD_TranslateExpr(bin.Right, ctx, uniforms);
                string op = bin.Kind() switch
                {
                    SyntaxKind.AddExpression => " + ",
                    SyntaxKind.SubtractExpression => " - ",
                    SyntaxKind.MultiplyExpression => " * ",
                    SyntaxKind.DivideExpression => " / ",
                    _ => " ?? "
                };
                return $"({l}{op}{r})";
            }

            // Invocation: math.floor → component.floor()
            if (expr is InvocationExpressionSyntax inv)
            {
                var sym = _semanticModel.GetSymbolInfo(inv).Symbol as IMethodSymbol;
                if (sym?.ContainingType?.ToDisplayString() == "EntJoy.Mathematics.math")
                {
                    var args = inv.ArgumentList.Arguments;
                    switch (sym.Name)
                    {
                        case "floor":
                            return $"({FWSIMD_ComponentString(args[0].Expression, component, ctx, uniforms)}).floor()";
                        case "clamp":
                        {
                            string v = FWSIMD_ComponentString(args[0].Expression, component, ctx, uniforms);
                            string lo = FWSIMD_ComponentString(args[1].Expression, component, ctx, uniforms);
                            string hi = FWSIMD_ComponentString(args[2].Expression, component, ctx, uniforms);
                            return $"min(max({v}, {lo}), {hi})";
                        }
                        case "distancesq":
                            return FWSIMD_TranslateExpr(inv, ctx, uniforms);
                    }
                }
                return FWSIMD_TranslateExpr(inv, ctx, uniforms);
            }

            // Object creation: new float2(a, b)
            if (expr is ObjectCreationExpressionSyntax obj)
            {
                var args = obj.ArgumentList?.Arguments ?? new SeparatedSyntaxList<ArgumentSyntax>();
                int compIdx = component == 'x' ? 0 : 1;
                return compIdx < args.Count
                    ? FWSIMD_TranslateExpr(args[compIdx].Expression, ctx, uniforms)
                    : "0";
            }

            // For non-vector expressions, just translate normally
            if (type?.Name is "float" or "int" or "uint")
                return FWSIMD_TranslateExpr(expr, ctx, uniforms);

            return FWSIMD_TranslateExpr(expr, ctx, uniforms);
        }

        /// <summary>Get the simd_value<T> type name for a C# type, or null if should remain scalar</summary>
        private static string? GetSIMDValueType(ITypeSymbol type)
        {
            // Roslyn returns SpecialType for primitives (Single, Int32), not C# aliases (float, int)
            if (type.SpecialType == SpecialType.System_Single) return "simd_value<float>";
            if (type.SpecialType == SpecialType.System_Int32) return "simd_value<int>";
            if (type.Name == "float2") return "simd_value<EntJoy::Mathematics::float2>";
            if (type.Name == "int2") return "simd_value<EntJoy::Mathematics::int2>";
            return null;
        }

        /// <summary>Check if an expression involves only scalars (no SIMD variables)</summary>
        private bool FWSIMD_IsScalarOnly(ExpressionSyntax expr, HashSet<string> uniforms)
        {
            if (expr is LiteralExpressionSyntax) return true;
            if (expr is IdentifierNameSyntax id && uniforms.Contains(id.Identifier.Text)) return true;
            if (expr is MemberAccessExpressionSyntax ma && ma.Name.Identifier.Text is "MaxValue" or "zero") return true;
            if (expr is ObjectCreationExpressionSyntax) return true;
            if (expr is CastExpressionSyntax cast)
                return FWSIMD_IsScalarOnly(cast.Expression, uniforms);
            if (expr is BinaryExpressionSyntax bin)
                return FWSIMD_IsScalarOnly(bin.Left, uniforms) && FWSIMD_IsScalarOnly(bin.Right, uniforms);
            if (expr is PrefixUnaryExpressionSyntax pre)
                return FWSIMD_IsScalarOnly(pre.Operand, uniforms);
            return false;
        }

        // ================================================================
        // Full-Width SIMD: expression translator
        // ================================================================

        /// <summary>Identify SIMD variable references in an expression</summary>
        private bool FWSIMD_HasSIMDVar(ExpressionSyntax expr, FWSIMDCtx ctx)
        {
            foreach (var id in expr.DescendantNodesAndSelf().OfType<IdentifierNameSyntax>())
            {
                string n = id.Identifier.Text;
                if (ctx.SimdVars.Contains(n)) return true;
                // Array access generates SIMD gather even though the variable is uniform
                if (n == "SortedPositions" || n == "HashIndex" || n == "CellStartEnd") return true;
            }
            return false;
        }

        /// <summary>
        /// Translate a C# expression to a C++ SIMD expression string.
        /// For comparison operators involving SIMD types, generates n_cmp_*_ps/epi32 calls
        /// wrapped in simd_mask{ ... }.
        /// </summary>
        private string FWSIMD_TranslateExpr(ExpressionSyntax expr, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            // Unwrap parenthesized expressions
            while (expr is ParenthesizedExpressionSyntax paren)
                expr = paren.Expression;

            switch (expr)
            {
                case LiteralExpressionSyntax lit:
                    return FWSIMD_TranslateLiteral(lit);
                case IdentifierNameSyntax id:
                    return FWSIMD_TranslateIdent(id, ctx, uniforms);
                case MemberAccessExpressionSyntax ma:
                    return FWSIMD_TranslateMemberAccess(ma, ctx, uniforms);
                case InvocationExpressionSyntax inv:
                    return FWSIMD_TranslateInvocation(inv, ctx, uniforms);
                case BinaryExpressionSyntax bin:
                    return FWSIMD_TranslateBinary(bin, ctx, uniforms);
                case CastExpressionSyntax cast:
                    return FWSIMD_TranslateCast(cast, ctx, uniforms);
                case ObjectCreationExpressionSyntax obj:
                    return FWSIMD_TranslateObjectCreation(obj, ctx, uniforms);
                case ElementAccessExpressionSyntax elem:
                    return FWSIMD_TranslateElementAccess(elem, ctx, uniforms);
                case PrefixUnaryExpressionSyntax pre:
                    return FWSIMD_TranslatePrefixUnary(pre, ctx, uniforms);
                default:
                    return $"/*expr:{expr}*/";
            }
        }

        private string FWSIMD_TranslateLiteral(LiteralExpressionSyntax lit)
        {
            if (lit.Token.Value is float f)
                return f.ToString(System.Globalization.CultureInfo.InvariantCulture) + "f";
            if (lit.Token.Value is int iv)
                return iv.ToString();
            if (lit.Token.Value is bool b)
                return b ? "true" : "false";
            return lit.Token.Text;
        }

        private string FWSIMD_TranslateIdent(IdentifierNameSyntax id, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string name = id.Identifier.Text;
            // Bool field constants (IgnoreSelf) → const-folded value
            if (_boolFields.ContainsKey(name))
                return _boolFields[name];
            // SIMD variable → use v_ prefix
            if (ctx.SimdVars.Contains(name))
                return $"v_{name}";
            // Uniform fields (used as-is)
            if (uniforms.Contains(name))
                return name;
            // Known uniform names
            if (name == "GridOrigin" || name == "GridResolutionInv" || name == "GridDimensions"
                || name == "SortedLength" || name == "SquaredEpsilonSelf" || name == "IgnoreSelf")
                return name;
            // Array names → use as-is (with _ptr suffix added by element access)
            if (name == "QueryPositions" || name == "SortedPositions" || name == "HashIndex"
                || name == "CellStartEnd" || name == "Results")
                return name;
            return name; // loop vars and other scalars
        }

        private string FWSIMD_TranslateMemberAccess(MemberAccessExpressionSyntax ma, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string member = ma.Name.Identifier.Text;
            var exprType = _semanticModel.GetTypeInfo(ma.Expression).Type;
            string exprStr = FWSIMD_TranslateExpr(ma.Expression, ctx, uniforms);

            // int2.zero → make_int2(0,0)
            if (member == "zero" && IsVectorType(exprType))
            {
                string compNs = exprType?.Name switch { "float2" => "EntJoy::Mathematics::float2", "int2" => "EntJoy::Mathematics::int2", _ => exprType?.Name ?? "int2" };
                return $"{compNs}(0, 0)";
            }

            // float.MaxValue → 3.402823466e+38f
            if (member == "MaxValue" && exprType?.SpecialType == SpecialType.System_Single)
                return "3.402823466e+38f";

            // Vector .x / .y
            if (member == "x" || member == "y")
            {
                bool isUniform = uniforms.Contains(exprStr)
                    || exprStr == "GridOrigin" || exprStr == "GridDimensions"
                    || exprStr == "CellStartEnd";
                if (isUniform)
                    return $"{exprStr}.{member}()";
                return $"{exprStr}.{member}";
            }

            // NativeList.Length → _length
            if (member == "Length" && exprType?.Name == "NativeList")
                return $"{exprStr}._length";

            // NativeArray.Length → _length
            if (member == "Length" && exprType?.Name == "NativeArray")
                return $"{exprStr}_length";

            return $"/*{exprStr}.{member}*/";
        }

        private string FWSIMD_TranslateInvocation(InvocationExpressionSyntax inv, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            var sym = _semanticModel.GetSymbolInfo(inv).Symbol as IMethodSymbol;
            if (sym == null) return "/*unknown*/";

            // math.* functions
            if (sym.ContainingType?.ToDisplayString() == "EntJoy.Mathematics.math")
            {
                var args = inv.ArgumentList.Arguments;
                switch (sym.Name)
                {
                    case "floor":
                        return $"({FWSIMD_TranslateExpr(args[0].Expression, ctx, uniforms)}).floor()";
                    case "distancesq":
                    {
                        string a = FWSIMD_TranslateExpr(args[0].Expression, ctx, uniforms);
                        string b = FWSIMD_TranslateExpr(args[1].Expression, ctx, uniforms);
                        return $"(({a}).x - ({b}).x) * (({a}).x - ({b}).x) + (({a}).y - ({b}).y) * (({a}).y - ({b}).y)";
                    }
                    case "clamp":
                    {
                        string v = FWSIMD_TranslateExpr(args[0].Expression, ctx, uniforms);
                        string lo = FWSIMD_TranslateExpr(args[1].Expression, ctx, uniforms);
                        string hi = FWSIMD_TranslateExpr(args[2].Expression, ctx, uniforms);
                        // For compound types (int2/float2), broadcast scalars to SIMD
                        var retType = _semanticModel.GetTypeInfo(inv).Type;
                        if (retType?.Name is "int2" or "float2")
                        {
                            string compType = retType?.Name == "int2"
                                ? "EntJoy::Mathematics::int2"
                                : "EntJoy::Mathematics::float2";
                            string simdType = $"simd_value<{compType}>";
                            // Wrap scalar compound values in broadcast constructor (added in SimdValue.h)
                            return $"min(max({v}, {simdType}({compType}({lo}))), {simdType}({compType}({hi})))";
                        }
                        return $"min(max({v}, {lo}), {hi})";
                    }
                    case "abs":
                        return $"abs({FWSIMD_TranslateExpr(args[0].Expression, ctx, uniforms)})";
                }
            }

            return "/*call*/";
        }

        private string FWSIMD_TranslateBinary(BinaryExpressionSyntax bin, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            // Check if this is a comparison involving SIMD types
            bool isSIMDCmp = bin.Kind() switch
            {
                SyntaxKind.LessThanExpression or SyntaxKind.GreaterThanExpression
                or SyntaxKind.LessThanOrEqualExpression or SyntaxKind.GreaterThanOrEqualExpression
                or SyntaxKind.EqualsExpression or SyntaxKind.NotEqualsExpression => true,
                _ => false
            };

            if (isSIMDCmp && FWSIMD_HasSIMDVar(bin, ctx))
            {
                // Generate SIMD comparison → returns simd_mask expression
                return FWSIMD_GenerateSIMDCmp(bin, ctx, uniforms);
            }

            // Handle logical AND/OR with mixed scalar bool + SIMD mask
            if (bin.Kind() is SyntaxKind.LogicalAndExpression or SyntaxKind.LogicalOrExpression)
            {
                bool leftHasSIMD = FWSIMD_HasSIMDVar(bin.Left, ctx);
                bool rightHasSIMD = FWSIMD_HasSIMDVar(bin.Right, ctx);
                if (leftHasSIMD || rightHasSIMD)
                {
                    string l = FWSIMD_TranslateExpr(bin.Left, ctx, uniforms);
                    string r = FWSIMD_TranslateExpr(bin.Right, ctx, uniforms);
                    string logical_op = bin.Kind() == SyntaxKind.LogicalAndExpression ? " & " : " | ";
                    // Wrap scalar bool constants in simd_mask for mixed-type AND/OR
                    if (!leftHasSIMD && (l == "true" || l == "false"))
                        l = l == "true" ? "simd_mask::all_true()" : "simd_mask{ n_set1_ps(0.0f) }";
                    if (!rightHasSIMD && (r == "true" || r == "false"))
                        r = r == "true" ? "simd_mask::all_true()" : "simd_mask{ n_set1_ps(0.0f) }";
                    return $"({l}{logical_op}{r})";
                }
            }

            // Arithmetic or uniform-only comparison:
            string left = FWSIMD_TranslateExpr(bin.Left, ctx, uniforms);
            string right = FWSIMD_TranslateExpr(bin.Right, ctx, uniforms);

            string op = bin.Kind() switch
            {
                SyntaxKind.AddExpression => " + ",
                SyntaxKind.SubtractExpression => " - ",
                SyntaxKind.MultiplyExpression => " * ",
                SyntaxKind.DivideExpression => " / ",
                SyntaxKind.LogicalAndExpression => " && ",
                SyntaxKind.LogicalOrExpression => " || ",
                SyntaxKind.LessThanExpression => " < ",
                SyntaxKind.GreaterThanExpression => " > ",
                SyntaxKind.LessThanOrEqualExpression => " <= ",
                SyntaxKind.GreaterThanOrEqualExpression => " >= ",
                SyntaxKind.EqualsExpression => " == ",
                SyntaxKind.NotEqualsExpression => " != ",
                _ => " ?? "
            };
            return $"({left}{op}{right})";
        }

        /// <summary>Generate SIMD comparison intrinsic call: n_cmp_*_ps / n_cmp_*_epi32</summary>
        private string FWSIMD_GenerateSIMDCmp(BinaryExpressionSyntax bin, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            // Get C# types of operands (not SIMD types, original C# types)
            var leftType = _semanticModel.GetTypeInfo(bin.Left).Type;
            bool isFloatCmp = leftType?.SpecialType == SpecialType.System_Single
                || leftType?.Name == "float";
            bool isIntCmp = leftType?.SpecialType == SpecialType.System_Int32
                || leftType?.Name == "int";
            bool isUnsigned = false;

            // Check for unsigned casts: (uint)expr
            if (bin.Left is CastExpressionSyntax lc && lc.Type.ToString() == "uint") isUnsigned = true;
            if (bin.Right is CastExpressionSyntax rc && rc.Type.ToString() == "uint") isUnsigned = true;

            string func;
            if (isUnsigned)
            {
                func = bin.Kind() switch
                {
                    SyntaxKind.LessThanExpression => "n_cmp_ult_epi32",
                    SyntaxKind.GreaterThanExpression => "n_cmp_gt_epi32(a)!=n_cmp_ult_epi32(b,a)",
                    SyntaxKind.LessThanOrEqualExpression => "!n_cmp_gt_epi32(a)!=n_cmp_ult_epi32(b,a)",
                    SyntaxKind.GreaterThanOrEqualExpression => "n_cmp_ge_epi32(a)==~n_cmp_lt_epi32(a,b)",
                    _ => "n_cmp_eq_epi32"
                };
                // For unsigned, we always use n_cmp_ult_epi32 with NOT for >=
                // Simpler: just invert the condition for >=
                bool invert = bin.Kind() == SyntaxKind.GreaterThanOrEqualExpression
                    || bin.Kind() == SyntaxKind.GreaterThanExpression;
                // Get the operand expressions
                string lRaw = FWSIMD_TranslateExpr(stripCasts(bin.Left), ctx, uniforms);
                string rRaw = FWSIMD_TranslateExpr(stripCasts(bin.Right), ctx, uniforms);
                string lSIMD = WrapSIMDOperand(lRaw, ctx, "int");
                string rSIMD = WrapSIMDOperand(rRaw, ctx, "int");

                string cmp = $"n_cmp_ult_epi32({lSIMD}, {rSIMD})";
                if (invert) cmp = $"n_not_mask({cmp})";
                return $"simd_mask{{ {cmp} }}";
            }
            else if (isFloatCmp)
            {
                string funcName = bin.Kind() switch
                {
                    SyntaxKind.LessThanExpression => "n_cmp_lt_ps",
                    SyntaxKind.GreaterThanExpression => "n_cmp_gt_ps",
                    SyntaxKind.LessThanOrEqualExpression => "!(n_cmp_gt_ps(a,b))",
                    SyntaxKind.GreaterThanOrEqualExpression => "!(n_cmp_lt_ps(a,b))",
                    _ => "n_cmp_eq_ps" // need to add this
                };
                string lRaw = FWSIMD_TranslateExpr(bin.Left, ctx, uniforms);
                string rRaw = FWSIMD_TranslateExpr(bin.Right, ctx, uniforms);
                string lSIMD = WrapSIMDOperand(lRaw, ctx, "float");
                string rSIMD = WrapSIMDOperand(rRaw, ctx, "float");

                string cmp;
                switch (bin.Kind())
                {
                    case SyntaxKind.LessThanExpression:
                        cmp = $"n_cmp_lt_ps({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.GreaterThanExpression:
                        cmp = $"n_cmp_gt_ps({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.LessThanOrEqualExpression:
                        cmp = $"n_not_mask(n_cmp_gt_ps({lSIMD}, {rSIMD}))"; break;
                    case SyntaxKind.GreaterThanOrEqualExpression:
                        cmp = $"n_not_mask(n_cmp_lt_ps({lSIMD}, {rSIMD}))"; break;
                    default:
                        cmp = $"n_not_mask(n_cmp_lt_ps({lSIMD}, {rSIMD}))"; break;
                }
                return $"simd_mask{{ {cmp} }}";
            }
            else // int comparison
            {
                string lRaw = FWSIMD_TranslateExpr(bin.Left, ctx, uniforms);
                string rRaw = FWSIMD_TranslateExpr(bin.Right, ctx, uniforms);
                string lSIMD = WrapSIMDOperand(lRaw, ctx, "int");
                string rSIMD = WrapSIMDOperand(rRaw, ctx, "int");

                string cmp;
                switch (bin.Kind())
                {
                    case SyntaxKind.LessThanExpression:
                        cmp = $"n_cmp_lt_epi32({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.GreaterThanExpression:
                        cmp = $"n_cmp_gt_epi32({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.LessThanOrEqualExpression:
                        cmp = $"n_cmp_le_epi32({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.GreaterThanOrEqualExpression:
                        cmp = $"n_cmp_ge_epi32({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.EqualsExpression:
                        cmp = $"n_cmp_eq_epi32({lSIMD}, {rSIMD})"; break;
                    case SyntaxKind.NotEqualsExpression:
                        cmp = $"n_not_mask(n_cmp_eq_epi32({lSIMD}, {rSIMD}))"; break;
                    default:
                        cmp = $"n_cmp_eq_epi32({lSIMD}, {rSIMD})"; break;
                }
                return $"simd_mask{{ {cmp} }}";
            }
        }

        /// <summary>Strip (uint) and similar casts to get the inner expression</summary>
        private static ExpressionSyntax stripCasts(ExpressionSyntax expr)
        {
            while (expr is CastExpressionSyntax cast)
                expr = cast.Expression;
            return expr;
        }

        /// <summary>
        /// For a C++ expression string representing a comparison operand,
        /// wrap it appropriately for use in n_cmp_*_ps/epi32 calls.
        /// SIMD variables get .v appended, scalars get n_set1_* wrapped.
        /// </summary>
        private string WrapSIMDOperand(string rawExpr, FWSIMDCtx ctx, string type)
        {
            if (type == "float")
            {
                // Check if it's a SIMD variable reference (v_name)
                if (rawExpr.StartsWith("v_") && !rawExpr.Contains('(') && !rawExpr.Contains('[') && !rawExpr.Contains(' '))
                    return $"{rawExpr}.v";
                // Otherwise, it's a scalar → wrap in n_set1_ps
                return $"n_set1_ps({rawExpr})";
            }
            else // int
            {
                if (rawExpr.StartsWith("v_") && !rawExpr.Contains('(') && !rawExpr.Contains('[') && !rawExpr.Contains(' '))
                    return $"{rawExpr}.v";
                return $"n_set1_epi32({rawExpr})";
            }
        }

        /// <summary>
        /// Generate per-lane scalar expression from a C# RHS that contains SIMD variables.
        /// Replaces SIMD vars with n_extract_lane_* calls (used in per-lane write fallbacks).
        /// </summary>
        private string FWSIMD_RHSWithLaneExtract(ExpressionSyntax expr, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            switch (expr)
            {
                case IdentifierNameSyntax id:
                {
                    string name = id.Identifier.Text;
                    if (ctx.SimdVars.Contains(name))
                    {
                        var type = _semanticModel.GetTypeInfo(expr).Type;
                        return type?.SpecialType == SpecialType.System_Single
                            ? $"n_extract_lane_f32(v_{name}.v, lane)"
                            : $"n_extract_lane_epi32(v_{name}.v, lane)";
                    }
                    if (_boolFields.ContainsKey(name)) return _boolFields[name];
                    return name;
                }
                case LiteralExpressionSyntax lit: return FWSIMD_TranslateLiteral(lit);
                case MemberAccessExpressionSyntax ma:
                {
                    string inner = FWSIMD_RHSWithLaneExtract(ma.Expression, ctx, uniforms);
                    string member = ma.Name.Identifier.Text;
                    var eType = _semanticModel.GetTypeInfo(ma.Expression).Type;
                    if (member == "x" || member == "y")
                    {
                        bool uni = uniforms.Contains(inner) || IsVectorType(eType)
                            || inner == "GridOrigin" || inner == "GridDimensions";
                        return uni ? $"{inner}.{member}()" : $"{inner}.{member}";
                    }
                    if (member == "zero" && IsVectorType(eType)) return "0";
                    return $"{inner}.{member}";
                }
                case ElementAccessExpressionSyntax elem:
                {
                    string inner = FWSIMD_RHSWithLaneExtract(elem.Expression, ctx, uniforms);
                    string idx = FWSIMD_RHSWithLaneExtract(elem.ArgumentList.Arguments[0].Expression, ctx, uniforms);
                    var eType = _semanticModel.GetTypeInfo(elem.Expression).Type;
                    if (eType?.Name is "NativeArray" or "NativeList")
                    {
                        if (inner is "SortedPositions" or "HashIndex" or "QueryPositions") inner += "_ptr";
                        else if (inner == "CellStartEnd") inner += ".Ptr";
                    }
                    return $"{inner}[{idx}]";
                }
                case InvocationExpressionSyntax inv:
                {
                    var sym = _semanticModel.GetSymbolInfo(inv).Symbol as IMethodSymbol;
                    if (sym?.ContainingType?.Name == "math" && sym.Name == "distancesq")
                    {
                        string a = FWSIMD_RHSWithLaneExtract(inv.ArgumentList.Arguments[0].Expression, ctx, uniforms);
                        string b = FWSIMD_RHSWithLaneExtract(inv.ArgumentList.Arguments[1].Expression, ctx, uniforms);
                        return $"(({a}).x()-({b}).x())*(({a}).x()-({b}).x())+(({a}).y()-({b}).y())*(({a}).y()-({b}).y())";
                    }
                    return FWSIMD_TranslateExpr(inv, ctx, uniforms);
                }
                case BinaryExpressionSyntax bin:
                {
                    string l = FWSIMD_RHSWithLaneExtract(bin.Left, ctx, uniforms);
                    string r = FWSIMD_RHSWithLaneExtract(bin.Right, ctx, uniforms);
                    string op = bin.Kind() switch
                    {
                        SyntaxKind.AddExpression => " + ", SyntaxKind.SubtractExpression => " - ",
                        SyntaxKind.MultiplyExpression => " * ", SyntaxKind.DivideExpression => " / ",
                        SyntaxKind.LessThanExpression => " < ", SyntaxKind.GreaterThanExpression => " > ",
                        SyntaxKind.EqualsExpression => " == ", SyntaxKind.NotEqualsExpression => " != ",
                        SyntaxKind.LogicalAndExpression => " && ", SyntaxKind.LogicalOrExpression => " || ",
                        _ => " ?? "
                    };
                    return $"({l}{op}{r})";
                }
                default: return FWSIMD_TranslateExpr(expr, ctx, uniforms);
            }
        }

        private string FWSIMD_TranslateCast(CastExpressionSyntax cast, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            var targetType = _semanticModel.GetTypeInfo(cast.Type).Type;
            var sourceType = _semanticModel.GetTypeInfo(cast.Expression).Type;
            string expr = FWSIMD_TranslateExpr(cast.Expression, ctx, uniforms);

            // (int2)float2_expr → SIMD float→int conversion per component
            if (targetType?.Name == "int2" && sourceType?.Name == "float2")
            {
                return $"/*int2_from_simd*/simd_value<int>::convert(({expr}))";
                // Actually this needs to be per-component for float2
                // simd_value<EntJoy::Mathematics::float2>::convert ??
                // We don't have that. So just use reinterpret
            }

            // (unsigned int)expr → C-style cast
            string targetCpp = NativeTranspiler.MapCSharpTypeToCpp(targetType!);
            return $"({targetCpp})({expr})";
        }

        private string FWSIMD_TranslateObjectCreation(ObjectCreationExpressionSyntax obj, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            var type = _semanticModel.GetTypeInfo(obj.Type).Type;
            var args = obj.ArgumentList?.Arguments ?? new SeparatedSyntaxList<ArgumentSyntax>();
            string argsStr = string.Join(", ", args.Select(a => FWSIMD_TranslateExpr(a.Expression, ctx, uniforms)));

            if (type?.Name == "int2") return $"int2({argsStr})";
            if (type?.Name == "float2") return $"float2({argsStr})";
            string cppType = type != null ? NativeTranspiler.MapCSharpTypeToCpp(type) : obj.Type.ToString();
            return $"{cppType}({argsStr})";
        }

        private string FWSIMD_TranslateElementAccess(ElementAccessExpressionSyntax elem, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            var exprType = _semanticModel.GetTypeInfo(elem.Expression).Type;
            string exprStr = FWSIMD_TranslateExpr(elem.Expression, ctx, uniforms);
            string idx = FWSIMD_TranslateExpr(elem.ArgumentList.Arguments[0].Expression, ctx, uniforms);

            if (exprType?.Name == "NativeArray" || exprType?.Name == "NativeList")
            {
                // Generate proper gather for SIMD element access
                var elemT = (exprType as INamedTypeSymbol)?.TypeArguments.FirstOrDefault();
                string ptrName = $"{exprStr}_ptr";
                if (elemT?.Name == "float2")
                    return $"simd_value<EntJoy::Mathematics::float2>::gather({ptrName}, {idx})";
                if (elemT?.Name == "int2")
                {
                    string basePtr = exprType?.Name == "NativeList" ? $"{exprStr}.Ptr" : ptrName;
                    // Clamp index to [0, GridDims.x*GridDims.y-1] — the unmasked gather reads
                    // ALL lanes including masked-out ones which may have out-of-bounds cellHash.
                    return $"[&]()->simd_value<EntJoy::Mathematics::int2>{{ simd_value<int> __c=simd_min(simd_max({idx}, simd_value<int>::broadcast(0)), simd_value<int>::broadcast(GridDimensions.x()*GridDimensions.y()-1)); return simd_value<EntJoy::Mathematics::int2>::gather({basePtr}, __c); }}()";
                }
                // Scalar element access
                return $"{exprStr}_ptr[{idx}]";
            }

            return $"{exprStr}[{idx}]";
        }

        private string FWSIMD_TranslatePrefixUnary(PrefixUnaryExpressionSyntax pre, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string operand = FWSIMD_TranslateExpr(pre.Operand, ctx, uniforms);
            if (pre.Kind() == SyntaxKind.UnaryMinusExpression) return $"(-{operand})";
            if (pre.Kind() == SyntaxKind.LogicalNotExpression) return $"(!{operand})";
            return operand;
        }

        private static bool IsVectorType(ITypeSymbol? type)
        {
            return type?.Name is "float2" or "int2" or "uint2";
        }

        // ================================================================
        // Full-Width SIMD: Control flow generators
        // ================================================================

        /// <summary>Helper: Get statements from a StatementSyntax, unwrapping BlockSyntax</summary>
        private static IEnumerable<StatementSyntax> GetStmts(StatementSyntax stmt)
        {
            if (stmt is BlockSyntax block) return block.Statements;
            return new[] { stmt };
        }

        /// <summary>Generate SIMD for for-statements</summary>
        private void FWSIMD_GenerateForStatement(ForStatementSyntax forStmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            bool hasSIMDBounds = FWSIMD_CheckVaryingBounds(forStmt, ctx);
            if (hasSIMDBounds)
                FWSIMD_GenerateVaryingForLoop(forStmt, sb, ctx, uniforms);
            else
                FWSIMD_GenerateUniformForLoop(forStmt, sb, ctx, uniforms);
        }

        /// <summary>Check if for-loop bounds reference SIMD variables</summary>
        private bool FWSIMD_CheckVaryingBounds(ForStatementSyntax forStmt, FWSIMDCtx ctx)
        {
            if (forStmt.Condition == null) return false;
            return FWSIMD_HasSIMDVar(forStmt.Condition, ctx);
        }

        /// <summary>Uniform-bound loop (dx/dy): scalar loop, SIMD body</summary>
        private void FWSIMD_GenerateUniformForLoop(ForStatementSyntax forStmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string header = forStmt.Declaration?.ToString() ?? "int i = 0";
            string cond = forStmt.Condition?.ToString() ?? "true";
            string incr = string.Join(", ", forStmt.Incrementors.Select(i => i.ToString()));
            sb.AppendLine(ctx.I() + $"for ({header}; {cond}; {incr})");
            sb.AppendLine(ctx.I() + "{");
            ctx.Indent++;
            FWSIMD_GenerateStatements(
                GetStmts(forStmt.Statement),
                sb, ctx, uniforms);
            ctx.Indent--;
            sb.AppendLine(ctx.I() + "}");
        }

        /// <summary>Varying-bound loop (inner reduction): v_i + 1 mask-managed SIMD loop</summary>
        private void FWSIMD_GenerateVaryingForLoop(ForStatementSyntax forStmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            string loopVar = forStmt.Declaration?.Variables.First().Identifier.Text ?? "i";
            string condStr = forStmt.Condition?.ToString() ?? "";
            string endVal = condStr.Contains('<') ? condStr.Substring(condStr.IndexOf('<') + 1).Trim() : "";
            string startVal = forStmt.Declaration?.Variables.First().Initializer?.Value.ToString() ?? "0";

            // Parse start/end SIMD names
            string vStart = ctx.SimdVars.Contains(startVal) ? $"v_{startVal}" : startVal;
            string vEnd = ctx.SimdVars.Contains(endVal) ? $"v_{endVal}" : endVal;

            // Register loop variable as SIMD so body translates i → v_i
            ctx.SimdVars.Add(loopVar);

            // Wrap scalar start value in broadcast; SIMD start values are already SIMD
            string vInit = ctx.SimdVars.Contains(startVal) ? vStart : $"simd_value<int>::broadcast({vStart})";
            string mLoopName = ctx.NewMask();
            sb.AppendLine(ctx.I() + $"simd_value<int> v_{loopVar} = {vInit};");
            sb.AppendLine(ctx.I() + "while (true)");
            sb.AppendLine(ctx.I() + "{");
            ctx.Indent++;
            sb.AppendLine(ctx.I() + $"simd_mask {mLoopName} = __mask & (v_{loopVar} < {vEnd});");
            sb.AppendLine(ctx.I() + $"if ({mLoopName}.all_false()) break;");

            FWSIMD_GenerateStatements(
                GetStmts(forStmt.Statement),
                sb, ctx, uniforms);

            sb.AppendLine(ctx.I() + $"v_{loopVar} = v_{loopVar} + 1;");
            ctx.Indent--;
            sb.AppendLine(ctx.I() + "}");
        }

        /// <summary>Generate SIMD for if-statements (mask management)</summary>
        private void FWSIMD_GenerateIfStatement(IfStatementSyntax ifStmt, StringBuilder sb, FWSIMDCtx ctx, HashSet<string> uniforms)
        {
            bool isSIMD = FWSIMD_HasSIMDVar(ifStmt.Condition, ctx);

            if (!isSIMD)
            {
                // Uniform condition → regular if (all lanes same)
                string cond = FWSIMD_TranslateExpr(ifStmt.Condition, ctx, uniforms);
                sb.AppendLine(ctx.I() + $"if ({cond})");
                sb.AppendLine(ctx.I() + "{");
                ctx.Indent++;
                FWSIMD_GenerateStatements(GetStmts(ifStmt.Statement), sb, ctx, uniforms);
                ctx.Indent--;
                sb.AppendLine(ctx.I() + "}");
                if (ifStmt.Else != null)
                {
                    sb.AppendLine(ctx.I() + "else");
                    sb.AppendLine(ctx.I() + "{");
                    ctx.Indent++;
                    FWSIMD_GenerateStatements(GetStmts(ifStmt.Else.Statement), sb, ctx, uniforms);
                    ctx.Indent--;
                    sb.AppendLine(ctx.I() + "}");
                }
                return;
            }

            // SIMD condition
            // Classify: continue-only, simple-assignment, or complex
            bool isContinueOnly = false, isSimpleAssign = false;
            CheckIfPattern(ifStmt, out isContinueOnly, out isSimpleAssign);

            // Generate the SIMD mask for the condition
            // The condition may be "cond_to_skip" for continue, or "cond_to_update" for blend
            // We generate the mask as-is and let the handler invert or use directly
            string maskExpr = FWSIMD_TranslateExpr(ifStmt.Condition, ctx, uniforms);

            if (isContinueOnly)
            {
                // Pattern: if (cond) continue;
                // We invert: lanes where cond is FALSE remain active
                string mName = ctx.NewMask();
                // mask = __mask & ~cond → active lanes are those where cond is FALSE
                sb.AppendLine(ctx.I() + $"simd_mask {mName} = __mask & ~({maskExpr});");
                sb.AppendLine(ctx.I() + $"if ({mName}.all_false()) continue;");
                sb.AppendLine(ctx.I() + $"__mask = {mName};");
            }
            else if (isSimpleAssign)
            {
                // Pattern: if (cond) { best = val; idx = i; } or { Results[idx] = HashIndex[bestIdx].y; }
                // For SIMD variable assignments: blend; for array writes: per-lane fallback
                foreach (var s in GetStmts(ifStmt.Statement))
                {
                    if (s is ExpressionStatementSyntax es && es.Expression is AssignmentExpressionSyntax asgn)
                    {
                        if (asgn.Left is IdentifierNameSyntax targetId)
                        {
                            string rhs = FWSIMD_TranslateExpr(asgn.Right, ctx, uniforms);
                            sb.AppendLine(ctx.I() + $"v_{targetId.Identifier.Text} = blend(v_{targetId.Identifier.Text}, {rhs}, {maskExpr});");
                        }
                        else
                        {
                            FWSIMD_GenerateAssignment(asgn, sb, ctx, uniforms);
                        }
                    }
                }
            }
            else
            {
                // Complex if → push/pop mask
                string mName = ctx.NewMask();
                sb.AppendLine(ctx.I() + $"simd_mask {mName} = __mask & {maskExpr};");
                sb.AppendLine(ctx.I() + $"if ({mName}.any_true())");
                sb.AppendLine(ctx.I() + "{");
                ctx.Indent++;
                sb.AppendLine(ctx.I() + $"__mask = {mName};");
                FWSIMD_GenerateStatements(GetStmts(ifStmt.Statement), sb, ctx, uniforms);
                ctx.Indent--;
                sb.AppendLine(ctx.I() + "}");

                if (ifStmt.Else != null)
                {
                    string mElse = ctx.NewMask();
                    sb.AppendLine(ctx.I() + "else");
                    sb.AppendLine(ctx.I() + "{");
                    ctx.Indent++;
                    sb.AppendLine(ctx.I() + $"simd_mask {mElse} = __mask & ~{maskExpr};");
                    sb.AppendLine(ctx.I() + $"if ({mElse}.any_true()) __mask = {mElse};");
                    FWSIMD_GenerateStatements(GetStmts(ifStmt.Else.Statement), sb, ctx, uniforms);
                    ctx.Indent--;
                    sb.AppendLine(ctx.I() + "}");
                }
            }
        }

        /// <summary>Classify if-statement pattern: continue-only or simple-assignment blend</summary>
        private void CheckIfPattern(IfStatementSyntax ifStmt, out bool isContinueOnly, out bool isSimpleAssign)
        {
            isContinueOnly = false;
            isSimpleAssign = false;

            if (ifStmt.Else != null) return;

            // Check for continue statement
            var inner = ifStmt.Statement;
            while (inner is BlockSyntax blk && blk.Statements.Count == 1)
                inner = blk.Statements[0];
            if (inner is ContinueStatementSyntax)
            {
                isContinueOnly = true;
                return;
            }

            // Check for simple assignments (reduction pattern: SIMD-variable = expr)
            var bodyStmts = GetStmts(ifStmt.Statement).ToList();
            if (bodyStmts.Count >= 1 && bodyStmts.Count <= 3)
            {
                bool allSimpleAssign = true;
                foreach (var s in bodyStmts)
                {
                    // Must be assignment to SIMD variable (Identifier), not array element
                    if (!(s is ExpressionStatementSyntax es && es.Expression is AssignmentExpressionSyntax asgn
                          && asgn.Left is IdentifierNameSyntax))
                    {
                        allSimpleAssign = false;
                        break;
                    }
                }
                if (allSimpleAssign) isSimpleAssign = true;
            }
        }

        // ----------------------------------------------------------------
        // Path 1: Register SIMD (for simple SoA jobs: pos += vel * dt)
        // ----------------------------------------------------------------
        private string GenerateRegisterSIMD(string scalarBody)
        {
            var sb = new StringBuilder();
            sb.AppendLine("    // --- Outer SIMD: register-to-register ---");
            sb.AppendLine("    int simd_end_ = __startIndex + ((__count) / NSIMD_WIDTH) * NSIMD_WIDTH;");
            sb.AppendLine("    if (simd_end_ > __startIndex)");
            sb.AppendLine("    {");
            sb.AppendLine("        for (int si = __startIndex; si < simd_end_; si += NSIMD_WIDTH)");
            sb.AppendLine("        {");
            // Parse arr[i] = arr[i] op rhs — translate to load + op + store
            foreach (var line in scalarBody.Split('\n'))
            {
                var t = line.Trim();
                if (string.IsNullOrEmpty(t)) continue;
                string translated = TranslateAssignmentLine(t);
                if (translated != null)
                    sb.Append("            ").AppendLine(translated);
                else
                    sb.Append("            ").AppendLine(t);
            }
            sb.AppendLine("        }");
            sb.AppendLine("    }");
            sb.AppendLine(RemainderLoop(scalarBody));
            return sb.ToString();
        }

        private string? TranslateAssignmentLine(string line)
        {
            // Pattern: arr_ptr[index] = arr_ptr[index] + other_ptr[index] * dt;
            //        field_ptr[index] = field_ptr[index] + val;
            var match = Regex.Match(line,
                @"^\s*(?<arr>\w+)_ptr\[index\]\s*=\s*(?:\k<arr>_ptr\[index\]|(?<lhs>\w+)_ptr\[index\])\s*" +
                @"(?<op>[+\-*/])\s*(?:(?<rhs>\w+)_ptr\[index\]|(?<con>[a-zA-Z_]\w*))\s*;\s*$");
            if (match.Success)
            {
                string arr = match.Groups["arr"].Value;
                string op = match.Groups["op"].Value;
                string rhs = match.Groups["rhs"].Success ? match.Groups["rhs"].Value : match.Groups["con"].Value;

                // detect if rhs from group "con" is a scalar constant (dt, gravity, etc.)
                if (match.Groups["con"].Success)
                {
                    // arr[index] = arr[index] op scalar
                    return $"simd_value<float> v_{arr} = simd_value<float>::load(&{arr}_ptr[si]);\n" +
                           $"            v_{arr} = v_{arr} {op} {rhs};\n" +
                           $"            v_{arr}.store(&{arr}_ptr[si]);";
                }
                else
                {
                    // arr[index] = arr[index] op other[index]
                    return $"simd_value<float> v_{arr} = simd_value<float>::load(&{arr}_ptr[si]);\n" +
                           $"            simd_value<float> v_{rhs} = simd_value<float>::load(&{rhs}_ptr[si]);\n" +
                           $"            v_{arr} = v_{arr} {op} v_{rhs};\n" +
                           $"            v_{arr}.store(&{arr}_ptr[si]);";
                }
            }
            return null;
        }

        // ----------------------------------------------------------------
        // Path 2: Per-lane scalar (for complex bodies like ClosestPoint)
        // ----------------------------------------------------------------
        private string GeneratePerLane(string scalarBody)
        {
            var sb = new StringBuilder();
            sb.AppendLine("    // --- Outer SIMD: per-lane (register extract) ---");
            sb.AppendLine("    int simd_end_ = __startIndex + ((__count) / NSIMD_WIDTH) * NSIMD_WIDTH;");
            sb.AppendLine("    if (simd_end_ > __startIndex)");
            sb.AppendLine("    {");
            sb.AppendLine("        simd_value<int> v_base = simd_value<int>::sequence(0);");
            sb.AppendLine("        for (int si = __startIndex; si < simd_end_; si += NSIMD_WIDTH)");
            sb.AppendLine("        {");
            sb.AppendLine("            simd_value<int> v_i = v_base + si;");
            sb.AppendLine("            simd_value<EntJoy::Mathematics::float2> v_q =");
            sb.AppendLine("                simd_value<EntJoy::Mathematics::float2>::gather(QueryPositions_ptr, v_i);");
            sb.AppendLine("            for (int lane = 0; lane < NSIMD_WIDTH; lane++)");
            sb.AppendLine("            {");
            sb.AppendLine("                int index = si + lane;");
            foreach (var kvp in _boolFields)
                sb.AppendLine($"                bool {kvp.Key} = {kvp.Value};");
            sb.AppendLine("                EntJoy::Mathematics::float2 qbuf; qbuf.x() = n_extract_lane_f32(v_q.x.v, lane); qbuf.y() = n_extract_lane_f32(v_q.y.v, lane);");
            foreach (var line in scalarBody.Split('\n'))
            {
                var l = line.TrimEnd();
                if (string.IsNullOrEmpty(l)) continue;
                l = l.Replace("QueryPositions_ptr[index]", "qbuf");
                sb.Append("                ").AppendLine(l);
            }
            sb.AppendLine("            }");
            sb.AppendLine("        }");
            sb.AppendLine("    }");
            sb.Append(RemainderLoop(scalarBody));
            return sb.ToString();
        }

        private string RemainderLoop(string scalarBody)
        {
            var sb = new StringBuilder();
            sb.AppendLine($"    for (int {_idx} = simd_end_; {_idx} < __startIndex + __count; ++{_idx})");
            sb.AppendLine("    {");
            foreach (var line in scalarBody.Split('\n'))
            {
                if (string.IsNullOrWhiteSpace(line)) continue;
                sb.Append("    ").AppendLine(line.TrimEnd());
            }
            sb.AppendLine("    }");
            return sb.ToString();
        }

        // ----------------------------------------------------------------
        // Path 3: Reduction inner SIMD (complex bodies like ClosestPoint)
        // Wraps query gather in SIMD, extracts each lane, then replaces
        // inner reduction loops (for i = start..end over array[i]) with
        // SIMD batch: gather 8 array elements → SIMD arithmetic → blend reduction
        // ----------------------------------------------------------------
        private string GenerateReductionSIMD(string scalarBody)
        {
            var sb = new StringBuilder();
            sb.AppendLine("    // --- Outer SIMD: reduction inner (SIMD inner loops) ---");
            sb.AppendLine("    int simd_end_ = __startIndex + ((__count) / NSIMD_WIDTH) * NSIMD_WIDTH;");
            sb.AppendLine("    if (simd_end_ > __startIndex)");
            sb.AppendLine("    {");
            sb.AppendLine("        simd_value<int> v_base = simd_value<int>::sequence(0);");
            sb.AppendLine("        for (int si = __startIndex; si < simd_end_; si += NSIMD_WIDTH)");
            sb.AppendLine("        {");
            sb.AppendLine("            simd_value<int> v_i = v_base + si;");
            sb.AppendLine("            simd_value<EntJoy::Mathematics::float2> v_q =");
            sb.AppendLine("                simd_value<EntJoy::Mathematics::float2>::gather(QueryPositions_ptr, v_i);");
            sb.AppendLine("            for (int lane = 0; lane < NSIMD_WIDTH; lane++)");
            sb.AppendLine("            {");
            sb.AppendLine("                int index = si + lane;");
            foreach (var kvp in _boolFields)
                sb.AppendLine($"                bool {kvp.Key} = {kvp.Value};");
            sb.AppendLine("                EntJoy::Mathematics::float2 qbuf; qbuf.x() = n_extract_lane_f32(v_q.x.v, lane); qbuf.y() = n_extract_lane_f32(v_q.y.v, lane);");

            // Transform the scalar body: replace reduction loops with SIMD versions
            string transformed = TransformReductionLoops(scalarBody);
            foreach (var line in transformed.Split('\n'))
            {
                var l = line.TrimEnd();
                if (string.IsNullOrEmpty(l)) continue;
                sb.Append("                ").AppendLine(l);
            }

            sb.AppendLine("            }");
            sb.AppendLine("        }");
            sb.AppendLine("    }");
            sb.Append(RemainderLoop(scalarBody));
            return sb.ToString();
        }

        /// <summary>
        /// Scans C++ text for reduction for-loops (iterating over array_ptr[var])
        /// and replaces each with a SIMD batch loop + horizontal reduction + scalar remainder.
        /// </summary>
        private string TransformReductionLoops(string body)
        {
            // First apply the QueryPositions_ptr[index] -> qbuf text replacement
            string text = "";
            foreach (var line in body.Split('\n'))
            {
                var l = line.TrimEnd();
                if (string.IsNullOrEmpty(l)) continue;
                l = l.Replace("QueryPositions_ptr[index]", "qbuf");
                text += l + "\n";
            }

            var sb = new StringBuilder();
            int i = 0;
            while (i < text.Length)
            {
                int forIdx = text.IndexOf("for (int ", i);
                if (forIdx < 0) { sb.Append(text.Substring(i)); break; }

                sb.Append(text.Substring(i, forIdx - i));

                // Extract for-loop header: "for (int VAR = START; ...; VAR++)"
                int parenStart = text.IndexOf('(', forIdx);
                int parenEnd = FindMatchingParen(text, parenStart);
                if (parenEnd < 0) { sb.Append(text.Substring(forIdx)); break; }

                string forHeader = text.Substring(forIdx, parenEnd + 1 - forIdx);

                // Only match: for (int VAR = START; VAR < END; VAR++)   (strict <, not <=)
                var headerMatch = Regex.Match(forHeader,
                    @"for\s*\(int\s+(?<var>\w+)\s*=\s*(?<start>[^;]+);" +
                    @"\s*\k<var>\s*<\s*(?!=)(?<end>[^;]+);" +
                    @"\s*\k<var>\+\+\)$");
                if (!headerMatch.Success)
                { sb.Append(forHeader); i = parenEnd + 1; continue; }

                string var = headerMatch.Groups["var"].Value;
                string startVal = headerMatch.Groups["start"].Value.Trim();
                string endVal = headerMatch.Groups["end"].Value.Trim();

                // Find opening brace of loop body (skip whitespace)
                int bracePos = parenEnd + 1;
                while (bracePos < text.Length && (text[bracePos] == ' ' || text[bracePos] == '\t' || text[bracePos] == '\n' || text[bracePos] == '\r'))
                    bracePos++;
                if (bracePos >= text.Length || text[bracePos] != '{')
                { sb.Append(forHeader); i = parenEnd + 1; continue; }

                // Find matching closing brace
                int braceEnd = FindMatchingBrace(text, bracePos);
                if (braceEnd < 0) { sb.Append(text.Substring(forIdx)); break; }

                string loopBody = text.Substring(bracePos + 1, braceEnd - bracePos - 1);

                // Detect array reduction pattern: array_ptr[VAR] + if (VAL < BEST) { BEST = VAL; IDX = VAR; }
                string loopContent = loopBody;
                var redMatch = Regex.Match(loopContent,
                    @"(?<arr>\w+)_ptr\[" + var + @"\]" +
                    @"[\s\S]*?if\s*\((?<val>\w+)\s*<\s*(?<best>\w+)\)" +
                    @"[\s\S]*?\k<best>\s*=\s*\k<val>;[\s\S]*" +
                    @"(?<idxVar>\w+)\s*=\s*" + var + @";",
                    RegexOptions.IgnoreCase);

                if (redMatch.Success)
                {
                    string arr = redMatch.Groups["arr"].Value;
                    string val = redMatch.Groups["val"].Value;
                    string best = redMatch.Groups["best"].Value;
                    string idxVar = redMatch.Groups["idxVar"].Value;

                    // fallback: directly find the last "WORD = loopVar;" in body
                    var directMatches = Regex.Matches(loopBody, @"(\w+)\s*=\s*" + var + @"\s*;");
                    if (directMatches.Count > 0)
                        idxVar = directMatches[directMatches.Count - 1].Groups[1].Value;

                    string simdCode = GenerateSimdInnerLoop(arr, var, startVal, endVal, val, best, idxVar, loopBody);
                    sb.Append(simdCode);
                }
                else
                {
                    sb.Append(text.Substring(forIdx, braceEnd + 1 - forIdx));
                }

                i = braceEnd + 1;
            }
            return sb.ToString();
        }

        /// <summary>
        /// Generate SIMD batch loop + horizontal reduction + scalar remainder
        /// for a single reduction loop over an AoS array.
        /// </summary>
        private static string GenerateSimdInnerLoop(string arr, string var, string start, string endVal, string val, string best, string idxVar, string originalBody)
        {
            var sb = new StringBuilder();
            // Only use SIMD when there are enough elements to amortize gather+reduction overhead
            sb.AppendLine($"    if (({endVal} - {start}) >= NSIMD_WIDTH)");
            sb.AppendLine("    {");
            sb.AppendLine("    simd_value<float> v_qx = simd_value<float>::broadcast(qbuf.x());");
            sb.AppendLine("    simd_value<float> v_qy = simd_value<float>::broadcast(qbuf.y());");
            sb.AppendLine($"    simd_value<float> v_{best} = simd_value<float>::broadcast({best});");
            sb.AppendLine($"    simd_value<int> v_{idxVar} = simd_value<int>::broadcast({idxVar});");
            sb.AppendLine($"    simd_value<int> v_idx = simd_value<int>::sequence({start});");
            sb.AppendLine($"    int i_simd_end = {endVal} - (({endVal} - {start}) % NSIMD_WIDTH);");
            sb.AppendLine($"    for (int i_si = {start}; i_si < i_simd_end; i_si += NSIMD_WIDTH)");
            sb.AppendLine("    {");
            sb.AppendLine($"        simd_value<float> v_px = simd_value<float>::gathf({arr}_ptr, v_idx.v);");
            sb.AppendLine($"        simd_value<float> v_py = simd_value<float>::gathfy({arr}_ptr, v_idx.v);");
            sb.AppendLine($"        simd_value<float> v_dx = v_qx - v_px;");
            sb.AppendLine($"        simd_value<float> v_dy = v_qy - v_py;");
            sb.AppendLine($"        simd_value<float> v_{val} = v_dx * v_dx + v_dy * v_dy;");
            sb.AppendLine($"        simd_mask mask = simd_mask{{ n_cmp_lt_ps(v_{val}.v, v_{best}.v) }};");
            sb.AppendLine($"        v_{best} = blend(v_{best}, v_{val}, mask);");
            sb.AppendLine($"        v_{idxVar} = blend(v_{idxVar}, v_idx, mask);");
            sb.AppendLine($"        v_idx = v_idx + NSIMD_WIDTH;");
            sb.AppendLine("    }");
            sb.AppendLine($"    {best} = hmin(v_{best});");
            sb.AppendLine($"    {idxVar} = hmin_idx(v_{best}, v_{idxVar});");
            // scalar remainder
            sb.AppendLine($"    for (int {var} = i_simd_end; {var} < {endVal}; {var}++)");
            sb.AppendLine("    {");
            foreach (var origLine in originalBody.Split('\n'))
                sb.AppendLine($"        {origLine}");
            sb.AppendLine("    }");
            sb.AppendLine("    }");
            sb.AppendLine("    else");
            sb.AppendLine("    {");
            sb.AppendLine($"    for (int {var} = {start}; {var} < {endVal}; {var}++)");
            sb.AppendLine("    {");
            foreach (var origLine in originalBody.Split('\n'))
                sb.AppendLine($"        {origLine}");
            sb.AppendLine("    }");
            sb.AppendLine("    }");
            return sb.ToString();
        }

        /// <summary>
        /// Find matching closing brace for an opening brace at openPos.
        /// Handles nested braces by counting depth.
        /// </summary>
        private static int FindMatchingBrace(string text, int openPos)
        {
            int depth = 0;
            for (int i = openPos; i < text.Length; i++)
            {
                if (text[i] == '{') depth++;
                else if (text[i] == '}')
                {
                    depth--;
                    if (depth == 0) return i;
                }
            }
            return -1;
        }

        /// <summary>
        /// Find matching closing parenthesis for an opening paren at openPos.
        /// </summary>
        private static int FindMatchingParen(string text, int openPos)
        {
            int depth = 0;
            for (int i = openPos; i < text.Length; i++)
            {
                if (text[i] == '(') depth++;
                else if (text[i] == ')')
                {
                    depth--;
                    if (depth == 0) return i;
                }
            }
            return -1;
        }

        // ----------------------------------------------------------------
        // Body analysis
        // ----------------------------------------------------------------
        private bool IsSimpleSoaBody()
        {
            if (_methodSyntax.Body == null) return false;
            foreach (var stmt in _methodSyntax.Body.Statements)
            {
                if (stmt is ForStatementSyntax || stmt is WhileStatementSyntax || stmt is DoStatementSyntax
                    || stmt is IfStatementSyntax)
                    return false;
            }
            return true;
        }

        // ----------------------------------------------------------------
        // Reduction loop detection (C# AST level)
        // ----------------------------------------------------------------
        private bool IsReductionBody()
        {
            if (_methodSyntax.Body == null) return false;
            foreach (var stmt in _methodSyntax.Body.Statements)
            {
                if (ContainsReductionForLoop(stmt))
                    return true;
            }
            return false;
        }

        private bool ContainsReductionForLoop(StatementSyntax stmt)
        {
            switch (stmt)
            {
                case ForStatementSyntax forStmt:
                    if (IsDataReductionLoop(forStmt))
                        return true;
                    // Recurse into for body to find nested loops
                    var inner = forStmt.Statement is BlockSyntax blk ? blk.Statements.ToArray() : new[] { forStmt.Statement };
                    foreach (var s in inner)
                        if (ContainsReductionForLoop(s)) return true;
                    return false;
                case IfStatementSyntax ifStmt:
                    var ifBody = ifStmt.Statement is BlockSyntax ib ? ib.Statements.ToArray() : new[] { ifStmt.Statement };
                    foreach (var s in ifBody)
                        if (ContainsReductionForLoop(s)) return true;
                    if (ifStmt.Else != null)
                    {
                        var elseBody = ifStmt.Else.Statement is BlockSyntax eb ? eb.Statements.ToArray() : new[] { ifStmt.Else.Statement };
                        foreach (var s in elseBody)
                            if (ContainsReductionForLoop(s)) return true;
                    }
                    return false;
                case BlockSyntax block:
                    foreach (var s in block.Statements)
                        if (ContainsReductionForLoop(s)) return true;
                    return false;
                default:
                    return false;
            }
        }

        private bool IsDataReductionLoop(ForStatementSyntax forStmt)
        {
            if (forStmt.Declaration == null || forStmt.Declaration.Variables.Count != 1)
                return false;
            if (forStmt.Condition == null)
                return false;
            // Check body for min/max reduction if statement
            var forBody = forStmt.Statement is BlockSyntax fb ? fb.Statements.ToArray() : new[] { forStmt.Statement };
            foreach (var s in forBody)
            {
                if (IsReductionIfStatement(s))
                    return true;
            }
            return false;
        }

        private bool IsReductionIfStatement(StatementSyntax stmt)
        {
            if (stmt is IfStatementSyntax ifStmt)
            {
                if (ifStmt.Condition is BinaryExpressionSyntax bin &&
                    (bin.IsKind(SyntaxKind.LessThanExpression) || bin.IsKind(SyntaxKind.GreaterThanExpression)))
                {
                    var trueBlock = ifStmt.Statement is BlockSyntax tb ? tb.Statements.ToArray() : new[] { ifStmt.Statement };
                    foreach (var s in trueBlock)
                    {
                        if (s is ExpressionStatementSyntax es && es.Expression is AssignmentExpressionSyntax)
                            return true;
                    }
                }
            }
            return false;
        }
    }
}
