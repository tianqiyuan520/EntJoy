<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeTranspiler 生成器回归夹具（F-9/F-10）：
       自带原生编译（生成 → 标记扫描 → CMake → C++ 编译），等价于真实消费方的构建链路；
       Program 里对生成代码做运行时语义断言（见 Program.cs 表头）。
       CI 直接 dotnet run 本工程（-c Release），退出码非 0 即失败。
       原生的编译与复制接线由共享 props/targets 提供（src\EntJoy.Jobs\msbuild\）。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <!-- 负向夹具：默认排除。用 -p:FixtureMarkerGate=true 编进来时，构建**必须失败**
       （生成器写出 __ENTJOY_UNSUPPORTED 标记 → NativeCompileTask 拒绝编译）。
       见 negative-check.ps1。 -->
  <ItemGroup>
    <Compile Remove="Negative\**" />
    <Compile Include="Negative\MarkerGateJob.cs" Condition="'$(FixtureMarkerGate)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EntJoy.ECS\EntJoy.ECS.csproj" />
    <ProjectReference Include="..\..\src\EntJoy.Jobs\EntJoy.Jobs.csproj" />
    <ProjectReference Include="..\..\src\EntJoy.Collections\EntJoy.Collections.csproj" />
    <ProjectReference Include="..\..\src\EntJoy.Mathematics\EntJoy.Mathematics.csproj" />
  </ItemGroup>

  <Import Project="..\..\src\EntJoy.Jobs\msbuild\EntJoy.Jobs.props" />
  <Import Project="..\..\src\EntJoy.Jobs\msbuild\EntJoy.Jobs.targets" />

</Project>
