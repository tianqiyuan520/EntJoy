<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EntJoy.Jobs\EntJoy.Jobs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 保底：确保 NativeDll.dll 在输出目录 -->
    <None Include="..\..\src\NativeDll\x64\Release\NativeDll.dll"
          Link="NativeDll.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\src\NativeDll\x64\Release\NativeDll.dll')" />
  </ItemGroup>
</Project>
