<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <AssemblyName>SafetyLockOverheadBench</AssemblyName>
    <RootNamespace>SafetyLockOverheadBench</RootNamespace>
    <!-- repro/ 是独立子项目：默认通配会把它与自身 obj/*.cs 一起编译进本程序集 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EntJoy.Collections\EntJoy.Collections.csproj" />
    <ProjectReference Include="..\..\src\EntJoy.Jobs\EntJoy.Jobs.csproj" />
  </ItemGroup>
</Project>
