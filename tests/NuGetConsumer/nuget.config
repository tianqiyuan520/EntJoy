<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet consumer smoke test feed: consume the packages produced by `dotnet pack` (see run.ps1).
     The local feed path is relative to this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-entjoy" value="..\..\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
