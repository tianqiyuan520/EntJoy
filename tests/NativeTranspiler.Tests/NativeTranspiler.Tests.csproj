<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 生成器工程是 analyzer 工程（IsRoslynComponent），这里只作为普通库引用，进程内驱动。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <!-- 与 src/NativeTranspiler/NativeTranspiler.csproj 保持同一版本 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NativeTranspiler\NativeTranspiler.csproj" />
    <!-- NT-06：命令行引号规则（CommandLineQuoting）在 MSBuild 任务工程里，用纯函数直接单测，
         不需要真的去跑 CMake。 -->
    <ProjectReference Include="..\..\src\NativeTranspiler.Tasks\NativeTranspiler.Tasks.csproj" />
  </ItemGroup>

</Project>
